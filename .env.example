# propsearch environment variables.
#
# In production these come from two places, never from a .env file:
#   - Secret Manager (propsearch-*), mounted by Cloud Run per service
#   - Plain env in infra/app-propsearch.tf (in the fungi repo)
#
# Copy to .env.local for local development.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev: a plain connection string. In CI, the Cloud SQL Auth Proxy
# provides this on 127.0.0.1.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/propsearch

# On Cloud Run these three replace DATABASE_URL entirely: the app connects over
# the mounted Unix socket using an IAM access token, so there is no password.
# CLOUD_SQL_INSTANCE_CONNECTION_NAME=fungi-family:asia-southeast1:fungi-db
# DB_NAME=propsearch
# DB_IAM_USER=propsearch-web@fungi-family.iam
# DB_POOL_MAX=2

# ---------------------------------------------------------------------------
# Auth — Google OAuth 2.0 (Secret Manager in production)
# ---------------------------------------------------------------------------
# Web-application client in the fungi-family project. Redirect URIs must include
# http://localhost:3000/auth/callback and the deployed origin's /auth/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# >= 32 chars. Generate with: openssl rand -base64 48
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Private GCS bucket for rendered PDFs. Credentials come from ADC (the Cloud Run
# runtime service account), so there is nothing else to set.
GCS_BUCKET=propsearch-reports

# ---------------------------------------------------------------------------
# PDF rendering
# ---------------------------------------------------------------------------
# The worker image installs Chromium at /usr/bin/chromium. Locally, point this
# at any Chrome/Chromium binary.
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ---------------------------------------------------------------------------
# Background jobs — Inngest
# ---------------------------------------------------------------------------
# From the Inngest dashboard. The app must be pointed at the WORKER service URL,
# not the web one.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_REASONING=
OPENAI_MODEL_COMPOSE=
OPENAI_MODEL_VISION=
OPENAI_MODEL_MINI=
# Optional; requests fall back to Anthropic when OpenAI fails.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FALLBACK=
# Optional tuning for the reason/select node.
OPENAI_RESPONSES_TIMEOUT_MS=
REASON_SHORTLIST=
REASON_BATCH_SIZE=
REASON_MAP_ATTEMPTS=
REASON_MAP_CONCURRENCY=
REASON_MAP_EFFORT=
REASON_MAP_TIMEOUT_MS=
VISION_COMPS_TOPK=

# ---------------------------------------------------------------------------
# Third-party data APIs
# ---------------------------------------------------------------------------
RAPIDAPI_KEY=
RAPIDAPI_REA_HOST=realty-base-au.p.rapidapi.com
MAPBOX_TOKEN=
GOOGLE_MAPS_KEY=
# Optional overrides; the tools layer has working defaults for each.
NSW_ARCGIS_BASE=
NSW_ONLINEDA_BASE=
VIC_VICMAP_WFS=
ABS_ASGS_BASE=
ABS_CENSUS_ARCGIS_BASE=
ABS_DATA_API_BASE=

# ---------------------------------------------------------------------------
# Observability (all optional — absent means disabled, not broken)
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
DAILY_REPORT_LIMIT=20
